{
  "name": "axones-assistant-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP de Axones — expone tools de lectura sobre la API Laravel para asistentes LLM (Claude Desktop, Cursor, etc.) y para el futuro chat embebido en la SPA.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "axones-assistant": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
