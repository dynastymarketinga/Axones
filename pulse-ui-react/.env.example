# URL base del API de Laravel (sin barra final), o vacío en desarrollo.
#
# Recomendado con túnel a Vite: dejar VACÍO. El build dev usa /api en el mismo host y vite.config
# hace proxy a http://127.0.0.1:8000 (un solo túnel, sin CORS).
# VITE_API_BASE_URL=
#
# Sin túnel, solo local:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
#
# Dos túneles (front y API con hosts distintos): URL del túnel del API; configura CORS en Laravel.
# VITE_API_BASE_URL=https://tu-tunel-api.trycloudflare.com/api
#
# Cloudflare Pages (build en panel o `npm run build:cf`): variable obligatoria en el proyecto → Settings → Environment variables
# VITE_API_BASE_URL=https://tu-api.ejemplo.com/api
