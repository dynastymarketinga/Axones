{
  "name": "axones-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tunnel": "cloudflared tunnel --url http://127.0.0.1:5173",
    "dev:share": "concurrently -k -n vite,tunnel -c cyan,magenta \"npm run dev\" \"npm run dev:tunnel\"",
    "build": "tsc -b && vite build",
    "build:deploy": "vite build",
    "build:cf": "npm run build && node scripts/prep-cloudflare-subpath.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
