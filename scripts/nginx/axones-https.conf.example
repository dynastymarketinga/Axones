# Axones — Nginx con HTTPS (copiar a /etc/nginx/sites-available/axones)
#
# 1) Generar certificado: sudo bash scripts/setup-https-selfsigned.sh
#    o Certbot: sudo bash scripts/setup-https-certbot.sh axones.tudominio.com
# 2) sudo ln -sf /etc/nginx/sites-available/axones /etc/nginx/sites-enabled/
# 3) sudo nginx -t && sudo systemctl reload nginx
#
# Ajusta APP_ROOT, server_name, rutas php-fpm y rutas SSL según tu servidor.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Redirigir HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name 10.0.0.2 axones.local;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name 10.0.0.2 axones.local;

    root /var/www/axones/backend/public;
    index index.php;

    # Rutas generadas por setup-https-selfsigned.sh o Certbot
    ssl_certificate     /etc/ssl/axones/axones-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/axones.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 32M;

    # SPA React (build en public/axones)
    location /axones/ {
        try_files $uri $uri/ /axones/index.html;
    }

    # Manifest / service worker (MIME correcto para PWA)
    location ~* ^/axones/.*\.(webmanifest|json)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=300";
        default_type application/manifest+json;
    }

    location = /axones/manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
    }

    # API Laravel
    location /api {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location /up {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
