# URL base de la API Axones (Laravel). En producción: https://axones/api
AXONES_API_BASE_URL=http://127.0.0.1:8000/api

# Token Bearer Sanctum. NUNCA pegues el token real aquí: este archivo se commitea.
# Genera el token en local con tinker (ver README) y guárdalo solo en bot/.env (gitignored).
#   php artisan tinker
#   >>> App\Models\User::findByLogin('admin')->createToken('mcp-bot')->plainTextToken
AXONES_API_TOKEN=

# Timeout de cada request a la API en ms (por defecto 15000).
# AXONES_API_TIMEOUT_MS=15000

# Origen público de la SPA para construir hrefs de dots (sin barra final).
# En dev: http://localhost:5173/axones — en prod: https://axones/axones
# Si se omite, los hrefs se devuelven como rutas relativas sin dominio.
# AXONES_SPA_BASE_URL=
